{
  "name": "neocut-desktop",
  "version": "0.1.0",
  "description": "NeoCut free-first video editor desktop app",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.neoos.neocut",
    "productName": "NeoCut",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../neocut-web",
        "to": "neocut-web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "maintainers@gw140427-rgb.github.io"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": {
    "name": "NeoCut contributors",
    "email": "maintainers@gw140427-rgb.github.io"
  },
  "homepage": "https://github.com/gw140427-rgb/Neoos-2/tree/feature/neocut-editor/apps/neocut-web"
}
